/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), microphone=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; img-src 'self' data: https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; connect-src 'self' https://static.cloudflareinsights.com

/favicon.ico
  Content-Type: image/x-icon
  Cache-Control: public, max-age=604800

/favicon-16.png
  Cache-Control: public, max-age=604800
/favicon-16-dark.png
  Cache-Control: public, max-age=604800
/favicon-32.png
  Cache-Control: public, max-age=604800
/favicon-32-dark.png
  Cache-Control: public, max-age=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=604800
/icon-192.png
  Cache-Control: public, max-age=604800
/icon-512.png
  Cache-Control: public, max-age=604800
/icon-512-maskable.png
  Cache-Control: public, max-age=604800

/site.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: public, max-age=86400

/data/manuscripts.json
  Cache-Control: public, max-age=3600
/data/mss/*
  Cache-Control: public, max-age=3600
/data/desk-seed.json
  Cache-Control: public, max-age=300
/data/translations/queue.json
  Cache-Control: public, max-age=300
/data/diagrams/*
  Cache-Control: public, max-age=86400

/fonts/*
  Cache-Control: public, max-age=31536000
