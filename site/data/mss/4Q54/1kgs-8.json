ויעלואת׳םה ]כ##הניםוהלוים׃והמלךשלמהוכ##[ לעדת ]","book":"1Kgs","chapter":"8","verse":"4","spaced":"[ ו את כל כלי ה קדש אשר ב אהל ו יעלו את׳ם ה ] כ##הנים ו ה לוים ׃ ו ה מלך שלמה ו כ##[ ל עדת ]"},{"ref":"4Q54 f6:7","text":"[ ישראלהנועדיםעלי׳ואת׳ולפניהארוןמז ]בחיםצאןובקראשרלאיספרוולא","book":"1Kgs","chapter":"8","verse":"5","spaced":"[ ישראל ה נועדים עלי׳ו את׳ו ל פני ה ארון מז ]בחים צאן ו בקר אשר לא יספרו ו לא"},{"ref":"4Q54 f6:8","text":"[ ימנומרב׃ויבאוהכהניםאתארוןברית ]יהוהאלמקמ׳ולדבירהביתאלקדש","book":"1Kgs","chapter":"8","verse":"5","spaced":"[ ימנו מ רב ׃ ו יבאו ה כהנים את ארון ברית ] יהוה אל מקמ׳ו ל דביר ה בית אל קדש"},{"ref":"4Q54 f6:9","text":"[ הקדשיםאלתחתכנפיהכרובים׃כיהכרוב ]י#?םפרשיכנפיםאלמקוםהארוןויסכו","book":"1Kgs","chapter":"8","verse":"6","spaced":"[ ה קדשים אל תחת כנפי ה כרובים ׃ כי ה כרוב ]י#?ם פרשי כנפים אל מקום ה ארון ו יסכו"},{"ref":"4Q54 f6:10","text":"[ הכרביםעלהארוןועלבדי׳ומלמעל׳ה׃ויארכוהבדיםויראו]ראשיהבדיםמןהקדש","book":"1Kgs","chapter":"8","verse":"7","spaced":"[ ה כרבים על ה ארון ו על בדי׳ו מ ל מעל׳ה ׃ ו יארכו ה בדים ו יראו ]ראשי ה בדים מן ה קדש"},{"ref":"4Q54 f6:11","text":"[ עלפניהדבירולאיראוהחוצ׳הויהיושםעדהיוםהזה׃איןבארון]ר##ק##שניהלחותהאבנים׃","book":"1Kgs","chapter":"8","verse":"8","spaced":"[ על פני ה דביר ו לא יראו ה חוצ׳ה ו יהיו שם עד ה יום ה זה ׃ אין ב ארון ]ר##ק## שני ה לחות ה אבנים ׃"}]},{"label":"f7","lines":[{"ref":"4Q54 f7:1","text":"[ ישראללבנותביתלהיותשמ׳ישםולאבחרתיבאישל ]היותנגידעלע#מ#׳[ יישראל ]","book":"1Kgs","chapter":"8","verse":"16","spaced":"[ ישראל ל בנות בית ל היות שמ׳י שם ו לא בחרתי ב איש ל ] היות נגיד על ע#מ#׳[ י ישראל ]"},{"ref":"4Q54 f7:2","text":"[ ואבחרבירושלםלהיותשמ׳ישםואבחרבדוד]להיותעלעמ׳יעל[ישראל׃ויהי ]","book":"1Kgs","chapter":"8","verse":"16","spaced":"[ ו אבחר ב ירושלם ל היות שמ׳י שם ו אבחר ב דוד ]ל היות על עמ׳י על[ ישראל ׃ ו יהי ]"},{"ref":"4Q54 f7:3","text":"[ עםלבבדודאב׳ילבנותביתלשםיהוהאלהיי ]שראל׃ויאמר[יהוהאלדודאב׳י ]׃","book":"1Kgs","chapter":"8","verse":"17","spaced":"[ עם לבב דוד אב׳י ל בנות בית ל שם יהוה אלהי י ]שראל ׃ ו יאמר[ יהוה אל דוד אב׳י ] ׃"}]}],"chapters":[{"id":"1kgs-7","book":"1Kgs","chapter":"7","label":"1 Kings 7","short":"7","path":"/m/4Q54/1kgs-7/","line_count":25},{"id":"4q54-f2ii","book":"4Q54","chapter":"f2ii","label":"Column f2ii","short":"f2ii","path":"/m/4Q54/4q54-f2ii/","line_count":1},{"id":"1kgs-8","book":"1Kgs","chapter":"8","label":"1 Kings 8","short":"8","path":"/m/4Q54/1kgs-8/","line_count":13},{"id":"4q54-f8","book":"4Q54","chapter":"f8","label":"Column f8","short":"f8","path":"/m/4Q54/4q54-f8/","line_count":3}],"view":"chapter","chapter_id":"1kgs-8","chapter":"8","book":"1Kgs","chapter_label":"1 Kings 8","prev":{"id":"4q54-f2ii","label":"Column f2ii","path":"/m/4Q54/4q54-f2ii/"},"next":{"id":"4q54-f8","label":"Column f8","path":"/m/4Q54/4q54-f8/"}}