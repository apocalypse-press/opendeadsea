"ref":"1Qisaa 10:24","text":"אזורחלצי׳ו׃וגרז?אבעמכבשונמרעמגדיירבץועגלוכפירימרויחדוונערקטןנהג","book":"Is","chapter":"11","verse":"5","spaced":"אזור חלצי׳ו ׃ ו גר ז?אב עמ כבש ו נמר עמ גדי ירבץ ו עגל ו כפיר ימרו יחדו ו נער קטן נהג"},{"ref":"1Qisaa 10:25","text":"ב׳מה׃ופרהודבתרעינהיחדוורבצוילדי׳הןואריהכבקריאכלתבן׃וישעשעיונק","book":"Is","chapter":"11","verse":"6","spaced":"ב׳מה ׃ ו פרה ו דב תרעינה יחדו ו רבצו ילדי׳הן ו אריה כ בקר יאכל תבן ׃ ו ישעשע יונק"},{"ref":"1Qisaa 10:26","text":"עלחורפתןועלמאורותצפעוניםגמוליד׳והדה׃לואירעוולואישחיתובהרקדש׳י","book":"Is","chapter":"11","verse":"8","spaced":"על חור פתן ו על מאורות צפעונים גמול יד׳ו הדה ׃ לוא ירעו ו לוא ישחיתו ב הר קדש׳י"},{"ref":"1Qisaa 10:27","text":"כיתמלא׳ההארץדעהאתיהוהכמיםליםמכסים׃","book":"Is","chapter":"11","verse":"9","spaced":"כי תמלא׳ה ה ארץ דעה את יהוה כ מים ל ים מכסים ׃"},{"ref":"1Qisaa 10:28","text":"והיהביוםההואשרשישיאשרעמדלנסעמיםאלי׳וגואיםידרושווהיאמנוחת׳ו","book":"Is","chapter":"11","verse":"10","spaced":"ו היה ב יום ה הוא שרש ישי אשר עמד ל נס עמים אלי׳ו גואים ידרושו ו היא מנוחת׳ו"},{"ref":"1Qisaa 10:29","text":"כבוד׃והיהביוםההואיוסיףאדונישניתיד׳ולקנות(^ את ^)שארעמ׳ואשרישאר","book":"Is","chapter":"11","verse":"10","spaced":"כבוד ׃ ו היה ב יום ה הוא יוסיף אדוני שנית יד׳ו ל קנות (^ את ^) שאר עמ׳ו אשר ישאר"},{"ref":"1Qisaa 10:30","text":"מאשורוממצריםומפתרוסומכושומעילםומשנער#ומחמתומאייהים׃ונשהנס","book":"Is","chapter":"11","verse":"11","spaced":"מ אשור ו מ מצרים ו מ פתרוס ו מ כוש ו מ עילם ו מ שנער# ו מ חמת ו מ איי ה ים ׃ ו נשה נס"}]},{"label":"11","lines":[{"ref":"1Qisaa 11:1","text":"לגואיםואספנדחיישראלונפוצותיהודהיקבצמכנפותהארץ׃וסרהקנאת","book":"Is","chapter":"11","verse":"12","spaced":"ל גואים ו אספ נדחי ישראל ו נפוצות יהודה יקבצ מ כנפות ה ארץ ׃ ו סרה קנאת"},{"ref":"1Qisaa 11:2","text":"אפריםוצוררייהודהיכרתואפריםלואיקנאאתיהודהויהודהלואיצראתאפרים׃","book":"Is","chapter":"11","verse":"13","spaced":"אפרים ו צוררי יהודה יכרתו אפרים לוא יקנא את יהודה ו יהודה לוא יצר את אפרים ׃"},{"ref":"1Qisaa 11:3","text":